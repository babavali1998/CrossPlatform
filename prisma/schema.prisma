// CrossPlatform database schema.
// Social tokens are stored AES-256-GCM encrypted (see src/lib/crypto.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL lives in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// App users (Auth.js)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  timezone      String    @default("America/Chicago")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  socialAccounts SocialAccount[]
  posts          Post[]
  media          MediaAsset[]
  oauthStates    OAuthState[]
}

// Auth.js login providers (Google/GitHub) for signing in to this app.
// Not to be confused with SocialAccount, which holds publishing connections.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Social publishing connections
// ---------------------------------------------------------------------------

enum Platform {
  THREADS
  INSTAGRAM
  X
  LINKEDIN
  FACEBOOK
  TIKTOK
  YOUTUBE
  PINTEREST
  BLUESKY
}

enum ConnectionStatus {
  ACTIVE
  NEEDS_RECONNECT
  REVOKED
}

model SocialAccount {
  id               String           @id @default(cuid())
  userId           String
  platform         Platform
  externalId       String
  username         String
  displayName      String?
  avatarUrl        String?
  accessTokenEnc   String           @db.Text
  refreshTokenEnc  String?          @db.Text
  tokenExpiresAt   DateTime?
  refreshExpiresAt DateTime?
  scopes           String[]
  status           ConnectionStatus @default(ACTIVE)
  statusMessage    String?
  // Per-account settings, e.g. { "maxChars": 280 } for X Premium accounts.
  settings         Json             @default("{}")
  lastSyncedAt     DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets   PostTarget[]
  followers FollowerSnapshot[]

  @@unique([userId, platform, externalId])
  @@index([userId])
}

// Short-lived CSRF state for social OAuth connections (PKCE verifier for X).
model OAuthState {
  id           String   @id // the random `state` value
  userId       String
  platform     Platform
  codeVerifier String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

enum MediaKind {
  IMAGE
  VIDEO
}

model MediaAsset {
  id           String    @id @default(cuid())
  userId       String
  key          String    @unique // object key in S3-compatible storage
  kind         MediaKind
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  durationSec  Float?
  originalName String?
  uploaded     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts PostMedia[]
}

// ---------------------------------------------------------------------------
// Posts
// ---------------------------------------------------------------------------

enum ContentMode {
  ORIGINAL
  AI_OPTIMIZED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  QUEUED // claimed by the scheduler, targets enqueued
  PUBLISHING
  PUBLISHED // every target published
  PARTIAL // some targets published, some failed
  FAILED // nothing published
  CANCELED
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model Post {
  id               String      @id @default(cuid())
  userId           String
  title            String?
  baseText         String      @db.Text
  mode             ContentMode @default(ORIGINAL)
  status           PostStatus  @default(DRAFT)
  scheduledAt      DateTime?
  publishedAt      DateTime?
  recurrence       Recurrence  @default(NONE)
  recurrenceEndsAt DateTime?
  // Set when this post was generated from a recurring parent.
  parentPostId     String?
  source           String      @default("composer") // composer | bulk | recurrence
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  media    PostMedia[]
  targets  PostTarget[]
  parent   Post?        @relation("Recurrence", fields: [parentPostId], references: [id], onDelete: SetNull)
  children Post[]       @relation("Recurrence")

  @@index([userId, status])
  @@index([status, scheduledAt])
}

model PostMedia {
  postId   String
  mediaId  String
  position Int

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([postId, mediaId])
}

enum TargetStatus {
  PENDING
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

// One row per (post, social account). This is the unit of publishing,
// retrying and idempotency: a PUBLISHED target is never sent again.
model PostTarget {
  id              String       @id @default(cuid())
  postId          String
  socialAccountId String
  text            String       @db.Text
  // Platform-specific options, e.g. { "igFormat": "REEL" }
  options         Json         @default("{}")
  status          TargetStatus @default(PENDING)
  externalId      String?
  externalUrl     String?
  // Resumable progress, e.g. a created-but-unpublished container id,
  // so a retry continues instead of creating a duplicate.
  providerState   Json         @default("{}")
  attempts        Int          @default(0)
  retryRound      Int          @default(0)
  lastError       String?      @db.Text
  lastErrorCode   String?
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  post          Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount    @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  logs          PublishLog[]
  metrics       MetricSnapshot[]

  @@unique([postId, socialAccountId])
  @@index([status])
}

model PublishLog {
  id        String   @id @default(cuid())
  targetId  String
  level     String // info | warn | error
  message   String
  data      Json?
  createdAt DateTime @default(now())

  target PostTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, createdAt])
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

model MetricSnapshot {
  id         String   @id @default(cuid())
  targetId   String
  capturedAt DateTime @default(now())
  views      Int?
  likes      Int?
  comments   Int?
  shares     Int?
  reach      Int?
  saves      Int?
  raw        Json?

  target PostTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, capturedAt])
}

model FollowerSnapshot {
  id              String   @id @default(cuid())
  socialAccountId String
  capturedAt      DateTime @default(now())
  followers       Int

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId, capturedAt])
}
