# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public URL of the web app. OAuth redirect URIs are built from this, and
# Meta (Instagram/Threads) requires https, so use a tunnel (ngrok,
# cloudflared) in local development when connecting those platforms.
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://app:app@localhost:5432/crossplatform
REDIS_URL=redis://localhost:6379

# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Auth.js secret: openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Signing in to this app (configure at least one)
# ---------------------------------------------------------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated emails allowed to sign in. Empty = anyone with an account.
ALLOWED_EMAILS=
# Local-only email login with no OAuth provider. Ignored in production.
ALLOW_DEV_LOGIN=false

# ---------------------------------------------------------------------------
# Object storage (any S3-compatible service: AWS S3, Cloudflare R2, MinIO)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=crossplatform
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Public base URL for media (CDN or public bucket). Instagram and Threads
# download media from this URL, so it must be reachable from the internet.
# If empty, 6-hour presigned URLs are used instead.
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# AI (optional; the AI Optimization mode and Assistant are disabled without it)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Platforms. Leave a platform's keys empty to hide its Connect button.
# Redirect URI to register for each: {APP_URL}/api/connect/<platform>/callback
# ---------------------------------------------------------------------------
# Instagram (Meta app -> Instagram API with Instagram Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v26.0

# Threads (Meta app -> Threads API use case)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_GRAPH_HOST=https://graph.threads.com
THREADS_AUTH_HOST=https://threads.com

# X (developer.x.com -> Project -> App -> OAuth 2.0, type "Web App")
X_CLIENT_ID=
X_CLIENT_SECRET=
# X bills analytics reads under pay-per-use, so metrics are opt-in.
X_ENABLE_METRICS=false

# LinkedIn (developer.linkedin.com -> app with "Share on LinkedIn" +
# "Sign In with LinkedIn using OpenID Connect")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202610

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=5
